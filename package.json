{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "C.Santhosh Kumar, Prince.A, Deepan.B",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch backend/src/server.ts",
    "build": "vite build && esbuild backend/src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "cross-env NODE_ENV=production node dist/server.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:frontend": "vitest run",
    "test:unit": "node --import tsx --test \"backend/src/**/*.test.ts\" \"db/assess/scoring/*.test.ts\" \"db/assess/test/**/*.test.ts\" && npm run test:frontend",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jimp": "^1.6.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
