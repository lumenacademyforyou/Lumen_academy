# Point this at the same Postgres database the authoring kit and
# gemini-question-gen run against (010_question_model.sql —> or, until the
# real file surfaces, 010_question_model.RECONSTRUCTED.sql, see the big
# warning header on that file —> 000_template_helpers.sql —>
# 012_question_variant.sql —> *.concept-tree.sql —> *.exam-template.sql —>
# *.syllabus.sql). The importer refuses to run against a database that
# hasn't had all of these loaded (it will fail loudly with a clear "no such
# table/function" error rather than something confusing).
DATABASE_URL=postgres://claude:claude@localhost:5432/lumen_test
