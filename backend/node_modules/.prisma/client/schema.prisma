generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model School {
  id                String       @id @default(uuid())
  name              String
  code              String       @unique
  board             String?
  schoolType        String?
  medium            String?
  address           String?
  district          String?
  state             String?
  pincode           String?
  plan              String?
  maxStudents       Int?
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  status            SchoolStatus @default(TRIAL)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  admins SchoolAdmin[]

  @@index([state, district])
  @@index([status])
}

model SchoolAdmin {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  phone     String?
  role      String?
  status    AdminStatus @default(ACTIVE)
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([schoolId])
  @@index([status])
}
