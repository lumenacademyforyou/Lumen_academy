        "label": "D",
        "text": "1:2",
        "isCorrect": false
      }
    ],
    "solution": {
      "explanationText": "R = ρL/A = ρL/(πr²). R₁/R₂ = (L₁/L₂)×(r₂/r₁)² = (2/1)×(2/1)² = 2×4 = 8, so R₁:R₂ = 8:1.",
      "solutionFormat": "plain"
