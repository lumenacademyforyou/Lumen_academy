# --- Backend (Express + Prisma) ---
NODE_ENV=development
PORT=4000

# Neon PostgreSQL connection string — application data (questions, attempts,
# scoring, AI cache). Not used for authentication.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Supabase Auth is the identity provider (email OTP + phone OTP). The backend
# verifies tokens by asking Supabase's Auth API directly (auth.getUser), so it
# only needs the same public project URL + publishable key as the frontend —
# no signing secret required, regardless of whether the project uses legacy
# HS256 or newer asymmetric JWT signing keys.
# Find both at: Supabase dashboard -> Project Settings -> API
SUPABASE_URL="https://dwsunzekwppyhdohsgoa.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_fHQlyqnNkoz-VoNpjt8XlA_H7Tt15w3"

# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173"
LOG_LEVEL="info"
#Admin@lumen1
# --- AI explanation layer ---
# "mock" requires no API key and returns a fixed response instantly.
AI_PROVIDER="mock"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:4000/api"

# Same Supabase project as above. Safe to expose to the client — the
# publishable key is public by design, protected by Supabase's row level
# security, not secrecy.
VITE_SUPABASE_URL="https://dwsunzekwppyhdohsgoa.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_fHQlyqnNkoz-VoNpjt8XlA_H7Tt15w3"

# --- Legacy, being migrated off — remove once Firebase/Gemini are fully retired ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
