# --- Backend (Express + Prisma) ---
NODE_ENV=development
PORT=4000

# Supabase Postgres connection string — application data (all catalog/core/
# content/assess/learn tables) and, separately, backend/generated/prisma's
# public.* tables. Use the SESSION POOLER string, not "Direct connection" —
# the direct db.<ref>.supabase.co host is IPv6-only unless the project has
# the paid IPv4 add-on, and most networks can't resolve it at all (this bit
# us for real — see git history/chat log if this comes up again). Get it from
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# Session pooler (port 5432, not the 6543 transaction pooler — DDL/migrations
# need session mode).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth is the identity provider (email OTP + phone OTP). The backend
# verifies tokens by asking Supabase's Auth API directly (auth.getUser), so it
# only needs the same public project URL + publishable key as the frontend —
# no signing secret required, regardless of whether the project uses legacy
# HS256 or newer asymmetric JWT signing keys.
# Find both at: Supabase dashboard -> Project Settings -> API. Must be the
# SAME project as DATABASE_URL above — core.app_user.auth_user_id is a real
# foreign key into that project's auth.users, so a mismatch breaks every
# authenticated request (this also bit us for real once).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...>"

# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173"
LOG_LEVEL="info"
#Admin@lumen1
# --- AI explanation layer ---
# "mock" requires no API key and returns a fixed response instantly.
AI_PROVIDER="mock"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# --- Database layer (db/) ---
# Redis — cache, BullMQ queues, live attempt state, rate limiting, idempotency (LA-ARC-001).
REDIS_URL=""

# Supabase service-role key — elevated, server-side only. Needed for Storage bucket
# writes / signed URLs on content.asset and content.source_document (LA-ARC-002).
# Supabase dashboard -> Project Settings -> API -> service_role secret. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Storage bucket for source PDFs, question images, generated answer-key PDFs.
# The database stores only the storage key/URI, never the bytes (LA-ARC-002).
OBJECT_STORAGE_BUCKET=""

# --- Frontend (Vite) ---
VITE_API_URL="http://localhost:4000/api"

# Same Supabase project as above. Safe to expose to the client — the
# publishable key is public by design, protected by Supabase's row level
# security, not secrecy.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...>"

# --- RBAC bootstrap (LA-CC-DB-001 Stage 6) ---
# Read once by db/scripts/bootstrap-super-admin.ts to resolve/create the
# platform super_admin and the pilot institution's institution_admin.
# Never hard-coded in SQL — the seed migration fails loudly if these are unset.
SUPER_ADMIN_EMAIL=""
PILOT_ADMIN_EMAIL=""

# STAGE 7 — set to "true" to point the Quick Demo Flow at the real
# db/assess-backed attempt lifecycle (/api/assess/attempts/*) instead of the
# older Prisma /api/tests/* demo path. Leave unset/"false" to keep the old
# path — this flag exists specifically so that path stays recoverable.
VITE_USE_REAL_API=""
# Required when VITE_USE_REAL_API=true: the assess.test.test_id to start.
# No "list available tests" endpoint exists yet, so this can't be discovered
# client-side — get it from db.scripts.seed.03_assess_fixture.ts's output.
VITE_DEMO_TEST_ID=""

# --- Legacy, being migrated off — remove once Firebase/Gemini are fully retired ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
