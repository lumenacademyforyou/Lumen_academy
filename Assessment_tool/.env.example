# LA-APP-COMPLETION-001 Phase H (H3) — this file did not exist anywhere in
# the repo or its git history despite README.md instructing `cp .env.example
# .env` as the very first setup step; `.gitignore`'s `.env*` pattern also
# silently blocked it from ever being tracked. A fresh clone could not
# actually follow the README. Fixed by adding this template (real values only
# in your own untracked `.env`) and excepting it in .gitignore.
#
# Names/requiredness below match backend/src/config/env.ts, db/config/env.ts,
# and frontend/src/services/supabase.ts + services/api.ts exactly — update
# this file if those change, not the other way around.

# --- Database (required) ---------------------------------------------------
# Real Postgres connection string (Supabase pooler or direct). Used by both
# backend/src/config/env.ts and db/config/env.ts.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# --- Supabase project — server-side (required) ------------------------------
# Auth only; the backend verifies tokens via Supabase's Auth API directly, so
# it never needs a JWT signing secret.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only, elevated privileges (bypasses RLS, Auth Admin API). Optional at
# boot — only admin scripts need it, never expose to the frontend/Vite bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Supabase project — frontend (Vite), required for the app to sign in ---
# Same project as above; VITE_-prefixed vars are the only ones exposed to the
# browser bundle.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Optional — defaults to http://localhost:4000/api (services/api.ts).
# VITE_API_URL="http://localhost:4000/api"
# Optional — enables Google One Tap auto-login on the landing page
# (services/googleOneTap.ts, assessment-tool-fix-prompt.md P0-1). Without it,
# One Tap is skipped entirely and only the existing "Continue with Google"
# OAuth-redirect button (supabaseAuth.ts's signInWithGoogle) is available.
# Must be a Google Cloud "OAuth 2.0 Client ID" (Web application type) with
# this app's origin(s) listed under "Authorized JavaScript origins", and the
# SAME client ID must be entered in Supabase Dashboard -> Authentication ->
# Providers -> Google -> "Client IDs" (for ID-token sign-in — separate field
# from the OAuth redirect client secret already configured there).
# VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# --- Backend server (optional, sensible defaults) ---------------------------
# PORT=4000
# CORS_ORIGINS="http://localhost:5173"
# NODE_ENV="development"
# LOG_LEVEL="info"

# --- Session management, Phase E (optional — directive's own stated defaults) ---
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12

# --- RBAC bootstrap (db/scripts/bootstrap-super-admin.ts) -------------------
# Read once to seed the platform super_admin and the pilot institution admin.
# SUPER_ADMIN_EMAIL="you@example.com"
# PILOT_ADMIN_EMAIL="you@example.com"

# --- Storage --------------------------------------------------------------
# Schema-optional (importing db/config/env.ts won't fail without it), but
# genuinely required at runtime: db/content/asset-resolver.ts throws
# immediately if unset, and every image-bearing published question depends
# on it (Phase B3). Set this for real if you're working with image content.
OBJECT_STORAGE_BUCKET="content-assets"
